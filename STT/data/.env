# ─── Porcupine Wake Word ────────────────────────────────────────────────────
# Отримай ключ безкоштовно на console.picovoice.io
PORCUPINE_ACCESS_KEY=4HbRGWC9kQBWALJNbOBUBrkGhMGCrykFEcS5sczdwhZf3FzlJGyT6w==

# Абсолютний шлях до .ppn файлу для Linux ARM (RPi 4).
# Завантаж Linux-ARM версію з console.picovoice.io — Windows .ppn не підійде.
WAKE_WORD_PATH=data/hey-Ava_en_windows_v4_0_0.ppn

# Чутливість Porcupine [0.0 – 1.0]. Вище = більше спрацювань, але більше хибних.
WAKE_WORD_SENSITIVITY=0.9

# ─── Whisper / STT ──────────────────────────────────────────────────────────
# Абсолютний шлях до ggml-tiny.bin. Лише tiny підходить для RPi 4 real-time.
WHISPER_MODEL_PATH=data/models/ggml-tiny.bin

# Кількість CPU потоків для Whisper. 3 — оптимум для RPi 4 (4 ядра, 1 вільне для ОС).
WHISPER_THREADS=2

# Мова розпізнавання. "uk" для укр., "en" для англ., "auto" для автодетекції.
WHISPER_LANGUAGE=uk

# ─── Аудіо ──────────────────────────────────────────────────────────────────
# Частота дискретизації. Porcupine та Whisper обидва вимагають 16000 Hz.
SAMPLERATE=16000

# Індекс аудіопристрою PvRecorder. -1 = системний за замовчуванням.
# Щоб знайти індекс мікрофону: python3 -c "from pvrecorder import PvRecorder; print(PvRecorder.get_available_devices())"
AUDIO_DEVICE_INDEX=-1

# ─── Буфер і ковзне вікно ───────────────────────────────────────────────────
# Розмір кільцевого буфера у секундах. 5 сек = 80 000 семплів float32.
BUFFER_SEC=5

# Крок ковзного вікна у секундах. Кожну секунду VAD перевіряє повний буфер.
SLIDE_SEC=1

# ─── VAD ────────────────────────────────────────────────────────────────────
# Режим webrtcvad [0–3]. 2 — збалансований між чутливістю і точністю.
VAD_MODE=2

# Мінімальна частка 30-мс фреймів з мовленням для підтвердження голосу.
VAD_SPEECH_RATIO=0.19

# ─── Wake Word Window ────────────────────────────────────────────────────────
# Скільки секунд після спрацювання wake word він залишається активним.
# Має збігатися з BUFFER_SEC: якщо wake word був у буфері — він релевантний.
WAKE_WINDOW_SEC=5